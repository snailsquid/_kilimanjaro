---
import type { Experience } from '../lib/schema';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;

function formatDate(value: string | undefined) {
  if (!value) return 'Present';
  const [year, month] = value.split('-');
  return `${year}.${month}`;
}
---

<section class="experience">
  <h2>Experience</h2>
  <div class="timeline">
    {
      experience.map((job, index) => (
        <article class="timeline-item" data-side={index % 2 === 0 ? 'left' : 'right'}>
          <span class="marker-label">{formatDate(job.start)}</span>
          <div class="timeline-content">
            <div class="timeline-header">
              <span class="company">{job.company}</span>
              <span class="dates">{formatDate(job.start)} — {job.current ? 'Present' : formatDate(job.end)}</span>
            </div>
            <h3>{job.role}</h3>
            {job.summary && <p class="summary">{job.summary}</p>}
            {job.highlights.length > 0 && (
              <ul class="highlights">
                {job.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
